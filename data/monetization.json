      "grants": { "crystals": 300, "credits": 5000, "skin": "aurum", "entitlement": "starter_pack" }
    },
    "crystals_s": {
      "type": "consumable", "name": "Handful of Crystals", "price": "$0.99", "icon": "crystal",
      "desc": "120 Crystals",
      "grants": { "crystals": 120 }
    },
    "crystals_m": {
      "type": "consumable", "name": "Cache of Crystals", "price": "$4.99", "icon": "crystal",
      "desc": "650 Crystals", "tag": "POPULAR",
      "grants": { "crystals": 650 }
    },
    "crystals_l": {
      "type": "consumable", "name": "Vault of Crystals", "price": "$9.99", "icon": "crystal",
      "desc": "1,500 Crystals", "tag": "BEST VALUE",
      "grants": { "crystals": 1500 }
    }
