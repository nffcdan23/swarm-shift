  "sectors": {
    "_doc": "What each sector adds. 'briefs' are shown in the lobby. From 'mutator_start' a sector takes one mutator from 'rotation' (by sector number), and from 'second_mutator_start' a second, different one. Mutator fields: speed / hp / spawn multiply the whole field; 'tracks' multiplies one enemy's spawn rate; 'every' repeats an event on a timer between 'from' and the boss; 'elite_affix' forces the affix elites spawn with.",
    "briefs": [
      { "sector": 1, "name": "FIRST CONTACT", "brief": "The swarm at its simplest. Keep moving and learn its shapes." },
      { "sector": 2, "name": "CROSSFIRE", "brief": "Weavers flank and Mortars shell the ground you stand on.", "new": ["weaver", "mortar"] },
      { "sector": 3, "name": "MELTDOWN", "brief": "Bombers and orbital bombardments. Watch the floor.", "new": ["bomber"] }
    ],
    "mutator_start": 4,
    "second_mutator_start": 10,
    "rotation": ["blitz", "artillery", "hunters", "elite_guard", "volatile", "horde"],
    "mutators": {
      "blitz": { "name": "BLITZ", "desc": "Everything moves 12% faster", "color": "#ffe14d", "speed": 1.12, "hp": 0.92 },
      "artillery": { "name": "ARTILLERY", "desc": "More Mortars and regular bombardments", "color": "#ff8a5c", "tracks": { "mortar": 1.6 },
        "every": { "seconds": 42, "from": 75, "event": { "type": "bombard", "label": "BOMBARDMENT", "count": 4 } } },
      "hunters": { "name": "HUNTERS", "desc": "Packs of Dashers and Weavers hunt you down", "color": "#5cf0ff", "tracks": { "dasher": 1.6, "weaver": 1.6 },
        "every": { "seconds": 38, "from": 60, "event": { "type": "pack", "label": "HUNTER PACK", "enemy": "dasher", "count": 6 } } },
      "elite_guard": { "name": "ELITE GUARD", "desc": "Elites arrive twice as often", "color": "#ffd15c",
        "every": { "seconds": 48, "from": 55, "event": { "type": "elite", "enemy": "brute", "escort": { "swarmer": 6 } } } },
      "volatile": { "name": "VOLATILE", "desc": "Bomber wings, and every elite explodes", "color": "#ff6a3d", "tracks": { "bomber": 1.3 }, "elite_affix": "volatile" },
      "horde": { "name": "HORDE", "desc": "A quarter more enemies, each a little weaker", "color": "#ff4d6d", "spawn": 1.25, "hp": 0.88 },

      "t_patrols": { "name": "ELITE PATROLS", "desc": "An extra elite with an escort every 50 seconds; they drop nothing", "color": "#ffd15c",
        "every": { "seconds": 50, "from": 80, "event": { "type": "elite", "enemy": "brute", "escort": { "swarmer": 4 }, "drops": false } } },
      "t_quick_shots": { "name": "QUICK SHOTS", "desc": "Enemy shots fly 20% faster", "color": "#ff7ab8", "shot_speed": 1.2 },
      "t_scarce_repairs": { "name": "SCARCE REPAIRS", "desc": "All healing is halved", "color": "#5cff8a", "heal": 0.5 },
      "t_crossfire": { "name": "CROSSFIRE", "desc": "A firing line of Shooters every 45 seconds", "color": "#ff9a5c",
        "every": { "seconds": 45, "from": 70, "event": { "type": "line", "label": "CROSSFIRE", "enemy": "shooter", "count": 5, "drops": false } } },
      "t_brood_elites": { "name": "BROOD ELITES", "desc": "Every elite also spawns Swarmers", "color": "#c98aff", "elite_extra_affix": "spawner" },
