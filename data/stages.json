  "threat": {
    "_doc": "Threat levels: cumulative modifiers for sectors already cleared. Level N adds levels[N-1].mutator on top of everything below it. Playing a sector at level N needs that sector cleared at N-1 (level 0 is the normal clear) and the Player's highest sector cleared at unlock_sector or beyond. Rewards: Credits and Player XP rise by reward_per_level / xp_per_level per level; the first clear of a sector at a level pays first_clear_credits x level x the sector's reward scale (once per sector and level); the first clear of a level on any sector pays milestone_crystals x level (once per level). Nothing about Threat repeats a Crystal reward.",
    "reward_per_level": 0.12,
    "xp_per_level": 0.08,
    "first_clear_credits": 50,
    "milestone_crystals": 5,
    "levels": [
      { "mutator": "t_patrols", "unlock_sector": 4 },
      { "mutator": "t_quick_shots", "unlock_sector": 6 },
      { "mutator": "t_scarce_repairs", "unlock_sector": 8 },
      { "mutator": "t_crossfire", "unlock_sector": 10 },
      { "mutator": "t_brood_elites", "unlock_sector": 12 },
      { "mutator": "t_wrath", "unlock_sector": 14 },
      { "mutator": "t_hunters", "unlock_sector": 16 },
      { "mutator": "t_scatter_fire", "unlock_sector": 18 },
      { "mutator": "t_no_second_chances", "unlock_sector": 20 },
      { "mutator": "t_final_protocol", "unlock_sector": 20 }
    ]
  },

