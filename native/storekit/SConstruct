#!/usr/bin/env python
# Builds the StoreKit bridge GDExtension. Run it through tools/build_storekit.sh,
# which compiles StoreKitBridge.swift first and sets the environment variables:
#
#   GODOT_CPP    path to godot-cpp
#   SWIFT_INCLUDE  folder holding the generated StoreKitBridge-Swift.h (iOS only)
#   OUT_DIR      where the library is written
import os

env = SConscript(os.path.join(os.environ["GODOT_CPP"], "SConstruct"))
env.Append(CPPPATH=["src/"])

sources = ["src/storekit_bridge.cpp", "src/register_types.cpp"]
out_dir = os.environ["OUT_DIR"]
name = "libstorekit.{}.{}".format(env["platform"], env["target"])

if env["platform"] == "ios":
    sources.append("src/storekit_ios.mm")
    env.Append(CPPPATH=[os.environ["SWIFT_INCLUDE"]])
    env.Append(CCFLAGS=["-fobjc-arc", "-fmodules", "-fcxx-modules"])
    library = env.StaticLibrary(os.path.join(out_dir, name + ".a"), source=sources)
else:
    sources.append("src/storekit_stub.cpp")
    if env["platform"] == "macos":
        target = os.path.join(out_dir, "{0}.framework/{0}".format(name))
    else:
        target = os.path.join(out_dir, name + env["SHLIBSUFFIX"])
    library = env.SharedLibrary(target, source=sources)

env.NoCache(library)
Default(library)
