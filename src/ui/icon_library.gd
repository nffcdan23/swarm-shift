static func has(id: String) -> bool:
	return ICONS.has(id)


## Draws icon `id` centred in `rect`. `weight` scales the stroke width.
static func draw(canvas: CanvasItem, id: String, rect: Rect2, color: Color, weight: float = 1.0) -> void:
	var ops: Array = ICONS.get(id, ICONS["star"])
	var centre := rect.get_center()
	var half := minf(rect.size.x, rect.size.y) * 0.5
	var width := maxf(half * 0.13 * weight, 1.5)
	for op: Array in ops:
		var kind: String = op[0]
		match kind:
			"l", "L", "p":
				var flat: Array = op[1]
				var points := PackedVector2Array()
				@warning_ignore("integer_division")
				var n := flat.size() / 2
				points.resize(n)
				for i in n:
					points[i] = centre + Vector2(float(flat[i * 2]), float(flat[i * 2 + 1])) * half
				if kind == "p":
					canvas.draw_colored_polygon(points, color)
				else:
					if kind == "L":
						points.append(points[0])
					canvas.draw_polyline(points, color, width, true)
			"c":
				canvas.draw_arc(centre + Vector2(float(op[1]), float(op[2])) * half, float(op[3]) * half, 0.0, TAU, 40, color, width, true)
			"d":
				canvas.draw_circle(centre + Vector2(float(op[1]), float(op[2])) * half, float(op[3]) * half, color)
			"a":
				canvas.draw_arc(centre + Vector2(float(op[1]), float(op[2])) * half, float(op[3]) * half,
					deg_to_rad(float(op[4])), deg_to_rad(float(op[5])), 28, color, width, true)
